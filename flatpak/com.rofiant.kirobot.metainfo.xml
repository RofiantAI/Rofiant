<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.rofiant.kirobot</id>
  <name>Rofiant</name>
  <summary>Chat, edit files, and run sandboxed commands with an AI agent</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="com.rofiant">
    <name>RofiantAI</name>
  </developer>
  <description>
    <p>
      Rofiant is a cross-platform desktop AI agent app. Chat with an AI
      assistant that can read and write files, run shell commands, and check
      git status and diffs inside an isolated sandbox, with a live view of
      what it's doing in Agent Activity, Files, and Terminal panels.
    </p>
  </description>
  <launchable type="desktop-id">com.rofiant.kirobot.desktop</launchable>
  <url type="homepage">https://github.com/RofiantAI/Rofiant</url>
  <url type="bugtracker">https://github.com/RofiantAI/Rofiant/issues</url>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/RofiantAI/Rofiant/master/flatpak/screenshots/01-welcome.png</image>
      <caption>Welcome screen</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/RofiantAI/Rofiant/master/flatpak/screenshots/02-builder.png</image>
      <caption>Agent writing code with a live file preview</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/RofiantAI/Rofiant/master/flatpak/screenshots/03-search.png</image>
      <caption>Agent activity panel showing a web search in progress</caption>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1" />
